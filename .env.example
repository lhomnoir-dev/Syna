# --- Telegram (obligatoire) ---------------------------------------------
# Token donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Whitelist stricte : vos IDs Telegram (via @userinfobot), séparés par des virgules
ALLOWED_USER_IDS=123456789
# Répondre « accès non autorisé » aux inconnus (false = ignorer silencieusement)
REPLY_UNAUTHORIZED=false

# --- Vault Obsidian (obligatoire) -----------------------------------------
OBSIDIAN_VAULT_PATH=/home/user/Documents/MonVaultObsidian
# Dossier par défaut des notes créées sans dossier (vide = racine du vault)
SYNA_INBOX_FOLDER=
# Dossier des réponses de /search enregistrées
SYNA_RESEARCH_FOLDER=Syna/Recherches
# Corbeille (les suppressions y déplacent les fichiers)
SYNA_TRASH_FOLDER=.trash

# --- Synchronisation Git ---------------------------------------------------
# pull avant chaque écriture, commit + push après
GIT_SYNC=false
GIT_REMOTE=origin
# GIT_BRANCH=main
GIT_COMMIT_MESSAGE=Syna bot update
# Pull périodique (secondes, 0 = désactivé)
GIT_PULL_INTERVAL=300

# --- Recherche externe -----------------------------------------------------
# tavily | exa | none
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXA_API_KEY=
WEB_RESULTS=4

# --- Synthèse LLM (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=
# Activée automatiquement si ANTHROPIC_API_KEY est défini
# SYNA_LLM_ENABLED=true
# Modèle rapide et économique pour la synthèse des recherches
SYNA_LLM_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
SYNA_LLM_EFFORT=low
SYNA_LLM_MAX_TOKENS=4000

# --- Recherche interne -----------------------------------------------------
# Modèle sentence-transformers pour la recherche sémantique (optionnel)
# ex. : paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_MODEL=
INTERNAL_RESULTS=5
# Nombre d'extraits de notes envoyés au LLM
CONTEXT_CHUNKS=6
# Réindexation automatique quand un fichier .md change (watchdog)
WATCH_VAULT=true

# --- /synote -----------------------------------------------------------------
# Seuil de similarité cosinus (0-1) : plus il est haut, moins il y a de liens
SYNOTE_THRESHOLD=0.30
SYNOTE_MAX_LINKS=5

# --- Telegram : messages longs ----------------------------------------------
# Au-delà, la réponse est envoyée en fichier .md
MAX_INLINE_CHARS=8000
